# Kopiera till .env (som aldrig committas):  cp .env.example .env
# .env är för din dator. I molnet sätts samma variabler hos plattformen (Render → Environment).

# Nyckeln som servern framför appen skickar till API:t. Lokalt: vad som helst,
# men samma värde används av både mock-API:t och Vite-proxyn.
API_KEY=lokal-utvecklingsnyckel

# Var API:t finns. Lokalt kör du det själv med npm run api.
API_URL=http://localhost:4000

# Hemligheten som signerar access tokens (minst 32 tecken). Lokalt: vad som helst som är långt nog.
# I molnet: ett slumpvärde per miljö – node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=lokal-utvecklingshemlighet-som-ar-lang-nog

# Refresh-cookien får flaggan Secure (= bara över https) när det här är true. Lokalt kör vi http.
COOKIE_SECURE=false
